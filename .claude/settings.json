{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx playwright test*)",
      "Bash(npm run *)",
      "Bash(npx vite*)",
      "Bash(powershell -File scripts/*)",
      "Bash(curl.exe -s*http://localhost*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
